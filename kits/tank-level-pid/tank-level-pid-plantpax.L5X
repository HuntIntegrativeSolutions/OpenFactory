<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.00" TargetName="OpenFactory" TargetType="Controller" ContainsContext="true" Owner="OpenFactory">
<Controller Use="Context" Name="OpenFactory">
<Tags>
<Tag Name="TK_01_LSH_DI" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[Level Control Tank — High level switch (on at hi_level)]]></Description>
</Tag>
<Tag Name="SIM_HEARTBEAT_DI" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[OpenFactory simulator heartbeat — 1 Hz square wave in simulated time, changes every 0.5 s; stops changing when the simulation or its protocol server stops]]></Description>
</Tag>
<Tag Name="FV_01_ZT_AI" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[Tank Inlet Level Control Valve — Position feedback [0 to 100 %]]]></Description>
</Tag>
<Tag Name="TK_01_LT_AI" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[Level Control Tank Level Transmitter — Process value [0 to 2 m]]]></Description>
</Tag>
<Tag Name="FV_01_POS_AO" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[Tank Inlet Level Control Valve — Position command [0 to 100 %]]]></Description>
</Tag>
<Tag Name="DEMO_LT_101" TagType="Base" DataType="P_AIn" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[Level Control Tank Level Transmitter LT-101]]></Description>
</Tag>
<Tag Name="DEMO_LIC_101" TagType="Base" DataType="P_PIDE" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[Level Control Tank Level Controller LIC-101]]></Description>
</Tag>
<Tag Name="DEMO_LV_101" TagType="Base" DataType="P_ValveC" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[Tank Inlet Level Control Valve LV-101]]></Description>
</Tag>
</Tags>
<Programs>
<Program Use="Target" Name="PlantPAx_Demo" MainRoutineName="MainRoutine" TestEdits="false" Disabled="false" UseAsFolder="false">
<Description><![CDATA[PlantPAx demo (OpenFactory PLAN 3.4): training and demo only, not safety-rated; names cited from PROCES-RM013I-EN-P, April 2023 (library 4.10.06); pending HIS Controls PE review]]></Description>
<Routines>
<Routine Use="Target" Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[First scan only: write the objects' configuration (Init)]]></Comment>
<Text><![CDATA[XIC(S:FS)JSR(Init,0);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[Every scan: wire the scene's tags to the PlantPAx objects (Control)]]></Comment>
<Text><![CDATA[JSR(Control,0);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Use="Target" Name="Init" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[LT-101 P_AIn: raw and engineering ranges equal, 0 to 2 m (OpenFactory writes metres)]]></Comment>
<Text><![CDATA[MOV(0.0,DEMO_LT_101.Cfg_InpRawMin)MOV(2.0,DEMO_LT_101.Cfg_InpRawMax)MOV(0.0,DEMO_LT_101.Cfg_PVEUMin)MOV(2.0,DEMO_LT_101.Cfg_PVEUMax);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[LIC-101 P_PIDE: PV 0 to 2 m, CV 0 to 100 %, CV limited 0 to 100 %]]></Comment>
<Text><![CDATA[MOV(0.0,DEMO_LIC_101.Cfg_PVEUMin)MOV(2.0,DEMO_LIC_101.Cfg_PVEUMax)MOV(0.0,DEMO_LIC_101.Cfg_CVEUMin)MOV(100.0,DEMO_LIC_101.Cfg_CVEUMax)MOV(0.0,DEMO_LIC_101.Cfg_MinCV)MOV(100.0,DEMO_LIC_101.Cfg_MaxCV);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[LIC-101 P_PIDE: PI from tank-level-pid, gain 8 %/%, 10 repeats/min, no derivative; dependent form, reverse acting (CV rises as the level falls) [TBD: verify the sense of Cfg_Depend and Cfg_CtrlAction in RM013 and Studio 5000]]]></Comment>
<Text><![CDATA[MOV(8.0,DEMO_LIC_101.Cfg_PGain)MOV(10.0,DEMO_LIC_101.Cfg_IGain)MOV(0.0,DEMO_LIC_101.Cfg_DGain)OTL(DEMO_LIC_101.Cfg_Depend)OTU(DEMO_LIC_101.Cfg_CtrlAction);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[LIC-101 P_PIDE: setpoint 1.0 m (tunable: PSet_SP), CV 0 % while interlocked]]></Comment>
<Text><![CDATA[MOV(1.0,DEMO_LIC_101.PSet_SP)MOV(0.0,DEMO_LIC_101.Cfg_IntlkCV);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[LIC-101 P_PIDE: program owner, automatic (one-shot program commands)]]></Comment>
<Text><![CDATA[OTL(DEMO_LIC_101.PCmd_Prog)OTL(DEMO_LIC_101.PCmd_Auto);]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment><![CDATA[LV-101 P_ValveC: CV and feedback 0 to 100 % both sides (the scene's AO and AI are in %); position feedback used; closed while interlocked]]></Comment>
<Text><![CDATA[OTL(DEMO_LV_101.Cfg_HasPosFdbk)MOV(0.0,DEMO_LV_101.Cfg_CVEUMin)MOV(100.0,DEMO_LV_101.Cfg_CVEUMax)MOV(0.0,DEMO_LV_101.Cfg_CVRawMin)MOV(100.0,DEMO_LV_101.Cfg_CVRawMax)MOV(0.0,DEMO_LV_101.Cfg_FdbkRawMin)MOV(100.0,DEMO_LV_101.Cfg_FdbkRawMax)MOV(0.0,DEMO_LV_101.Cfg_IntlkCV)OTL(DEMO_LV_101.PCmd_Prog);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Use="Target" Name="Control" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[LT-101 Level Control Tank level: TK_01_LT_AI (m) into P_AIn]]></Comment>
<Text><![CDATA[MOV(TK_01_LT_AI,DEMO_LT_101.Inp_PV);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[LT-101 P_AIn instance call [TBD: operand count, instance only here]]]></Comment>
<Text><![CDATA[P_AIn(DEMO_LT_101);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[LIC-101 PV from LT-101; a bad PV marks the controller's PV bad]]></Comment>
<Text><![CDATA[MOV(DEMO_LT_101.Val,DEMO_LIC_101.Inp_PV)XIC(DEMO_LT_101.Sts_PVBad)OTE(DEMO_LIC_101.Inp_PVBad);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Comment><![CDATA[LIC-101 interlock: the high level switch (LSH) holds the controller at 0 %]]></Comment>
<Text><![CDATA[XIO(TK_01_LSH_DI)OTE(DEMO_LIC_101.Inp_IntlkOK);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Comment><![CDATA[LIC-101 P_PIDE instance call [TBD: operand count, instance only here]]]></Comment>
<Text><![CDATA[P_PIDE(DEMO_LIC_101);]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Comment><![CDATA[LV-101 CV from LIC-101, position feedback from FV_01_ZT_AI, LSH closes the valve]]></Comment>
<Text><![CDATA[MOV(DEMO_LIC_101.Out_CV,DEMO_LV_101.PSet_CV)MOV(FV_01_ZT_AI,DEMO_LV_101.Inp_PosFdbk)XIO(TK_01_LSH_DI)OTE(DEMO_LV_101.Inp_IntlkOK);]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Comment><![CDATA[LV-101 P_ValveC instance call [TBD: operand count, instance only here]]]></Comment>
<Text><![CDATA[P_ValveC(DEMO_LV_101);]]></Text>
</Rung>
<Rung Number="7" Type="N">
<Comment><![CDATA[LV-101 valve position command to the simulator, FV_01_POS_AO (%)]]></Comment>
<Text><![CDATA[MOV(DEMO_LV_101.Out_CV,FV_01_POS_AO);]]></Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
