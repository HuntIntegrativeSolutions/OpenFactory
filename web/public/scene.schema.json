              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Engineering value at startup, before any PLC write (default 0); must be inside the port's range.",
          "title": "Initial"
        }
      },
      "required": [
        "tag"
      ],
      "title": "AoTagSpec",
      "type": "object"
    },
